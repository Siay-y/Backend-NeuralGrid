# Aplicação
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY_HOPS=0

# PostgreSQL
DATABASE_URL=postgres://neuralgrid:neuralgrid@localhost:5432/neuralgrid
DATABASE_SSL_MODE=disable

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=neuralgrid-api
JWT_AUDIENCE=neuralgrid-web

# Seed: usuario:Nome de exibição:papel, uma pessoa por vírgula, exatamente um master
SEED_USERS=mestre:Mestre:master,jogador1:Jogador 1:player,jogador2:Jogador 2:player,jogador3:Jogador 3:player
